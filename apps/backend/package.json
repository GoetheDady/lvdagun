{
  "name": "@lvdagun/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "lvdagun": "src/cli.ts"
  },
  "scripts": {
    "dev": "LVDAGUN_DEV=1 bun --hot src/cli.ts serve",
    "serve": "bun src/cli.ts serve",
    "stop": "bun src/cli.ts stop",
    "test": "vitest run --exclude 'tests/**/*.bun.test.ts' && bun test tests/history/sqlite-history-repository.bun.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@lvdagun/protocol": "workspace:*",
    "express": "^5.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
