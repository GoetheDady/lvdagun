{
  "name": "@lvdagun/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "lvdagun": "src/cli.ts"
  },
  "exports": {
    ".": "./src/protocol.ts"
  },
  "scripts": {
    "dev": "LVDAGUN_DEV=1 bun --hot src/cli.ts serve",
    "serve": "bun src/cli.ts serve",
    "stop": "bun src/cli.ts stop",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
