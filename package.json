{
  "name": "lvdagun",
  "version": "0.1.0",
  "private": true,
  "description": "驴打滚:部署在自己电脑上的个人 AI 管家",
  "workspaces": [
    "backend",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n backend,web -c green,blue \"bun --filter @lvdagun/backend dev\" \"bun --filter @lvdagun/web dev\"",
    "serve": "bun --filter @lvdagun/backend serve",
    "stop": "bun --filter @lvdagun/backend stop",
    "test": "bun --filter @lvdagun/backend test && bun --filter @lvdagun/web test",
    "typecheck": "bun --filter @lvdagun/backend typecheck && bun --filter @lvdagun/web typecheck",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "build": "bun --filter @lvdagun/web build && bun --filter @lvdagun/backend typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.1",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.38.0"
  }
}
